# Пароль администратора админки (ОБЯЗАТЕЛЬНО измените в продакшене)
ADMIN_PASSWORD=admin123

# Порт сервера (7860 — для Hugging Face Spaces, локально удобно 8000)
PORT=8000

# ── Автобэкап расписания в GitHub (на хостингах с эфемерным диском) ──
# Токен: GitHub → Settings → Developer settings → Personal access tokens
# (classic: право "repo"; fine-grained: Contents Read and Write для этого репозитория)
BACKUP_GH_TOKEN=
BACKUP_GH_REPO=allexme8-create/new-raspisanie
BACKUP_GH_BRANCH=schedule-data
BACKUP_GH_PATH=backup/state.json
